option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: demoproj.wsgi:application
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles

container_commands:
  01_chmod:
    command: "chmod +x .platform/hooks/postdeploy/*.sh || true"
  02_migrate:
    command: "$(find /var/app/venv -name python3 -type f | head -n 1) manage.py migrate --noinput"
    leader_only: true
