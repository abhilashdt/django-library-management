{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "LibraryDynamoDBAccess",
            "Effect": "Allow",
            "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
                "dynamodb:Scan",
                "dynamodb:Query",
                "dynamodb:DescribeTable"
            ],
            "Resource": [
                "arn:aws:dynamodb:us-east-1:*:table/library_books",
                "arn:aws:dynamodb:us-east-1:*:table/library_books/index/*",
                "arn:aws:dynamodb:us-east-1:*:table/library_members",
                "arn:aws:dynamodb:us-east-1:*:table/library_members/index/*",
                "arn:aws:dynamodb:us-east-1:*:table/library_loans",
                "arn:aws:dynamodb:us-east-1:*:table/library_loans/index/*"
            ]
        }
    ]
}
